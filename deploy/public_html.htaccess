# Tank Costing — cPanel / Apache front-end
# Place in public_html for subdomain (e.g. tankcalc.jmagroup.com.au)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API → Passenger Python app (adjust path to your cPanel application URL)
  RewriteRule ^api/(.*)$ http://127.0.0.1:8080/api/$1 [P,L]

  # SPA — serve static files or index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
